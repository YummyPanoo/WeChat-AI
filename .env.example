# 微信配置
WECHAT_TOKEN=your_wechat_token
WECHAT_APPID=your_appid
WECHAT_APPSECRET=your_appsecret
WECHAT_ASYNC=0

# AI 配置
DASHSCOPE_API_KEY=your_dashscope_api_key
# 轻量高速模型（避免个人订阅号同步模式 5 秒超时）
QWEN_TEXT_MODEL=qwen-turbo
QWEN_VL_MODEL=qwen-vl-plus
# 文生图模型（ModelScope 魔搭）
MODELSCOPE_API_KEY=your_modelscope_token
MODELSCOPE_T2I_MODEL=damo/text-to-image-synthesis
# 图生图模型（ModelScope 魔搭，图像编辑模型）
MODELSCOPE_I2I_MODEL=Qwen/Qwen-Image-Edit

# 服务配置
PORT=8080
LOG_LEVEL=INFO

# WeChatRegister 数据库配置（只读，用于查询用户订阅/订购信息）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=wechat_register

# WeChatRegister 前端地址（用于关注后推送的注册登录购买链接）
WECHAT_REGISTER_FRONTEND_URL=
